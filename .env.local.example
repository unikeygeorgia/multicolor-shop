# Multicolor — environment variables
# Copy to .env.local and fill in from your multicolor-shop Supabase project
# (Project Settings → API). NEXT_PUBLIC_* values are safe to expose client-side.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (never commit the real value). Required for /api/orders to create
# accounts + write user-linked orders. Get it from Supabase → Settings → API →
# "service_role" secret. Add to .env.local for dev AND to Vercel env vars.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Unichat AI bot — catalog sync (server-only; set in Vercel, never commit real values).
# When either is empty the sync is a SILENT no-op: /api/unichat/sync* return
# { ok: true, skipped: true } and nothing reaches Unichat.
UNICHAT_CATALOG_URL=https://app.unichat.ge/api/catalog
UNICHAT_CATALOG_API_KEY=

# Vercel cron auth (set in Vercel). Required by the nightly replace_all cron
# (/api/unichat/sync-all GET) — that cron is refused until this is set.
CRON_SECRET=
